# Things that are this machine's business, not the repository's.
password.txt
gate.txt
server.txt
.secret
inbox/
ingest-archive/
ingest.log
ingest-run.bat
service-run.bat

# The self-hosted server writes these next to itself when it runs.
selfhost/state.json
selfhost/state.json.bak
selfhost/backups/
selfhost/uploads/
selfhost/server.log
selfhost/*.pem

__pycache__/
*.pyc
~$*.xlsx

# Kingdom member data - names, governor IDs, stats. Kept on this machine,
# not published to the repository. The built pages count too: build.py bakes
# every week in Alliance Activity into them as starting data, so committing
# them would publish the roster just as surely as the spreadsheets do.
Alliance Activity/
output/
selfhost/index.html
